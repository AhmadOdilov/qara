# ─── Ma'lumotlar bazasi ────────────────────────────────────────────────────────
# Lokal Postgres (standart 5432-port). Rol va bazani yaratish:
#   psql -U postgres -c "CREATE ROLE qara LOGIN PASSWORD 'qara' CREATEDB"
#   psql -U postgres -c "CREATE DATABASE qara OWNER qara"
DATABASE_URL="postgresql://qara:qara@localhost:5432/qara?schema=public"
# Yoki Docker bilan (docker compose up -d) — u 5433-portda ko'tariladi:
# DATABASE_URL="postgresql://qara:qara@localhost:5433/qara?schema=public"

# ─── Ilova ────────────────────────────────────────────────────────────────────
# Deep link va OAuth callback'lar uchun ilovaning tashqi manzili
APP_URL="http://localhost:3000"
# Sessiya cookie'lari imzolanadigan maxfiy kalit.
# Yangisini oling:  openssl rand -base64 32
AUTH_SECRET="dev-only-secret-almashtiring-openssl-rand-base64-32"

# ─── Telegram bot ─────────────────────────────────────────────────────────────
# @BotFather -> /newbot -> tokenni shu yerga qo'ying.
# BO'SH QOLDIRSANGIZ ilova MOCK rejimda ishlaydi: Telegramga hech narsa
# yuborilmaydi, xabarlar lokal saqlanadi va bot javoblari simulyatsiya qilinadi.
TELEGRAM_BOT_TOKEN=""
# Botning @username'i (deep link https://t.me/<username>?start=<token> uchun)
TELEGRAM_BOT_USERNAME="qara_dev_bot"
# Webhook so'rovlarini tasdiqlash uchun maxfiy kalit (X-Telegram-Bot-Api-Secret-Token).
# Telegram'ga setWebhook qilganda ham shu qiymat beriladi.
TELEGRAM_WEBHOOK_SECRET="dev-webhook-secret-almashtiring"

# ─── Bot konstruktori sirlari ─────────────────────────────────────────────────
# Foydalanuvchilar yaratgan botlarning tokenlari va API kalitlari bazaga
# AES-256-GCM bilan shifrlangan holda yoziladi. Kalitni oling:
#   openssl rand -base64 32
# Bo'sh qoldirilsa AUTH_SECRET dan hosil qilinadi — dev uchun qulay, lekin
# prodda alohida belgilang: AUTH_SECRET almashsa sirlar ochilmay qoladi.
SECRETS_KEY=""

# ─── AI (Claude) ──────────────────────────────────────────────────────────────
# console.anthropic.com -> API Keys
# AI Product Planner (§6–7) shu kalit bilan ishlaydi: foydalanuvchi g'oyasini
# to'liq bot konfiguratsiyasiga aylantiradi.
# BO'SH QOLDIRSANGIZ ilova baribir ishlaydi: reja qoidaga asoslangan shablon
# generatori bilan tuziladi va UI'da buni ochiq ko'rsatadi.
ANTHROPIC_API_KEY=""

# ─── Docker (docker compose up -d) ────────────────────────────────────────────
# Konteyner ICHIDA `localhost` — konteynerning o'zi, baza emas. Shuning uchun
# Docker'dagi ilova bazaga SERVICE NOMI (`db`) orqali ulanadi. Bu qiymat
# compose'da yuqoridagi DATABASE_URL ning ustidan yoziladi.
DATABASE_URL_DOCKER="postgresql://qara:qara@db:5432/qara?schema=public"

# Postgres konteyneri uchun (parolni prodda albatta almashtiring)
POSTGRES_USER="qara"
POSTGRES_PASSWORD="qara"
POSTGRES_DB="qara"
# Host mashinada bazaga qaysi portdan kirish (faqat 127.0.0.1 ga ochiladi)
POSTGRES_PORT="5433"
# Ilova host mashinada qaysi portda ko'rinadi
APP_PORT="3000"

# ─── Google OAuth (Gmail bilan kirish) ────────────────────────────────────────
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Ruxsat etilgan redirect URI: {APP_URL}/api/auth/google/callback
# Bo'sh qoldirilsa — landing va login sahifasida Google tugmasi ko'rinmaydi.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Ishonchli proksi (rate limit uchun MUHIM) ────────────────────────────────
# Klient IP'si faqat sarlavhadan olinadi (Next route handler'da soket manzili
# berilmaydi). Shuning uchun zanjirning qaysi qismi ISHONCHLI ekanini shu
# yerda aytish kerak. Sozlanmasa X-Forwarded-For ga UMUMAN ishonilmaydi va
# rate limit hamma so'rov uchun umumiy bo'ladi (xavfsiz, lekin noqulay).
#
# Oldingizda nechta O'ZINGIZNING teskari proksingiz bor:
#   0 — ilova to'g'ridan-to'g'ri ochilgan (docker compose standart holati)
#   1 — bitta nginx / Caddy / Traefik
#   2 — CDN + nginx
TRUSTED_PROXY_HOPS="0"
#
# Yoki platforma o'zi yozadigan sarlavhani ko'rsating (u qayta yoziladi,
# shuning uchun klient unga ta'sir qila olmaydi). Ruxsat etilganlar:
#   cf-connecting-ip · true-client-ip · x-vercel-forwarded-for
#   fly-client-ip · x-real-ip
# Bu qiymat berilsa TRUSTED_PROXY_HOPS e'tiborga olinmaydi.
TRUSTED_PROXY_HEADER=""

# ─── HTTPS / domen (faqat docker-compose.prod.yml uchun) ──────────────────────
# Bu ikkitasi Caddy overlay'ini ko'tarish uchun SHART. Bo'sh qoldirilsa
# Caddy konfiguratsiyani umuman o'qiy olmaydi va ishga tushmaydi:
#   Error: adapting config using caddyfile: parsing caddyfile tokens
#   for 'email': wrong argument count ... at /etc/caddy/Caddyfile:15
# Ya'ni xato darhol va ochiq chiqadi — jimgina noto'g'ri ishlamaydi.
#
# Domen A/AAAA yozuvi SHU serverga ishora qilishi kerak: Let's Encrypt
# sertifikat berishdan oldin domenni tekshiradi. DNS tayyor bo'lmasa
# sertifikat OLINMAYDI.
SITE_DOMAIN=""
# Sertifikat muddati tugashi haqidagi ogohlantirish shu manzilga keladi.
ACME_EMAIL=""
#
# Caddy ortida ishlatganda yuqoridagi TRUSTED_PROXY_HOPS ni 1 ga o'zgartiring,
# aks holda rate limit hamma foydalanuvchi uchun umumiy chelakka tushadi.

# ─── To'lov provayderlari (§P3) ───────────────────────────────────────────────
# DIQQAT: bu qiymatlarni to'ldirish integratsiyani YOQMAYDI. Payme va Click
# adapterlari hozircha `configured: false` holatida, chunki protokolning
# ba'zi tafsilotlari rasmiy hujjatdan tasdiqlanmagan (lib/payments/payme.ts
# va click.ts izohlariga qarang). Soxta «to'landi» javobi yaratilmagan.
#
# Payme Merchant API — kabinetdan olinadi
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
# Test rejimi uchun sandbox kaliti (haqiqiy pul bilan sinamang)
PAYME_TEST_KEY=""
#
# Click SHOP-API — kabinetdan olinadi
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""

# ─── Narx konfiguratsiyasi (ixtiyoriy) ────────────────────────────────────────
# Tariflar `lib/pricing.ts` da. Bu qiymatlar berilmasa standart narx ishlaydi;
# o'zgartirish uchun qayta build qilish shart emas, faqat qayta ishga tushiring.
QARA_PRICE_STARTER_UZS="99000"
QARA_PRICE_BUSINESS_UZS="299000"
QARA_PRICE_PRO_UZS="899000"
# Bepul tarifda tushumdan olinadigan foiz
QARA_PRICE_FREE_GMV_FEE="1"
# Yillik to'lovda nechta oy hisoblanadi (12 oyga 10 oy)
QARA_ANNUAL_MONTHS="10"
# Faqat KO'RSATISH uchun taxminiy kurs; hisob-kitob har doim so'mda
QARA_USD_RATE="12000"
# per_workspace | per_bot | per_active_subscriber | ai_usage
QARA_BILLING_MODEL="per_workspace"

# ─── Avtomatlashtirish chegaralari (ixtiyoriy) ────────────────────────────────
# DIQQAT: bu qiymatlarni faqat PASAYTIRISH mumkin. Standartdan katta son
# berilsa e'tiborga olinmaydi — chegara himoya vazifasini bajaradi va uni
# muhit o'zgaruvchisi bilan o'chirib bo'lmasligi kerak.
# Ichma-ich `start_automation` chuqurligi (maks. 3)
AUTOMATION_MAX_DEPTH="3"
# Bitta hodisada bajariladigan amallar (maks. 20)
AUTOMATION_MAX_ACTIONS="20"
# Bitta ishga tushirish uchun vaqt chegarasi, ms (maks. 10000)
AUTOMATION_TIMEOUT_MS="10000"

# ─── Zaxira nusxa (scripts/backup-db.sh) ──────────────────────────────────────
# Nechа kundan eski zaxiralar avtomatik o'chiriladi
BACKUP_RETENTION_DAYS="14"
# Docker'dagi Postgres konteyneri nomi
POSTGRES_CONTAINER="qara-postgres"

# ─── Ulanishlar hovuzi (ixtiyoriy) ────────────────────────────────────────────
# Belgilanmasa Prisma standarti ishlaydi: yadro_soni × 2 + 1. Bitta ilova
# nusxasi uchun shu yetarli.
#
# BIR NECHTA nusxa bilan ishlatsangiz hisoblang:
#   connection_limit = (max_connections − 10) / nusxalar_soni
# va DATABASE_URL ga qo'shing:
#   ...?schema=public&connection_limit=15&pool_timeout=20
# Batafsil: docs/database.md

# ─── Xato kuzatuvi (ixtiyoriy, hali ULANMAGAN) ────────────────────────────────
# `app/error.tsx` da integratsiya uchun joy belgilangan, lekin Sentry
# o'rnatilmagan. Bu o'zgaruvchi hozircha HECH NARSA qilmaydi — u faqat
# kelajakdagi integratsiya uchun nom sifatida band qilingan.
# SENTRY_DSN=""
